from typing import Any

class QObject:
    def __init__(self, parent: Any = None) -> None: ...

class QWidget(QObject):
    def __init__(self, parent: Any = None) -> None: ...
    def actions(self) -> list[Any]: ...
    def setEnabled(self, enabled: bool) -> None: ...
    def isEnabled(self) -> bool: ...
    def setVisible(self, visible: bool) -> None: ...
    def setStyleSheet(self, style: str) -> None: ...
    def setWindowTitle(self, title: str) -> None: ...

class QMainWindow(QWidget):
    def addAction(self, action: Any) -> None: ...

class QDialog(QWidget):
    DialogCode: Any
    def exec(self) -> int: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...
    def result(self) -> int: ...

class QDialogButtonBox(QWidget):
    class StandardButton:
        Ok: Any
        Cancel: Any

    accepted: Any
    rejected: Any
    def __init__(self, buttons: Any = None, parent: Any = None) -> None: ...

class QTabWidget(QWidget):
    def __init__(self, parent: Any = None) -> None: ...
    def addTab(self, widget: Any, label: str) -> int: ...
    def count(self) -> int: ...
    def tabText(self, index: int) -> str: ...
    def currentIndex(self) -> int: ...
    def setCurrentIndex(self, index: int) -> None: ...

class QLabel(QWidget):
    def __init__(self, text: str, parent: Any = None) -> None: ...

class QLineEdit(QWidget):
    def __init__(self, parent: Any = None) -> None: ...
    def text(self) -> str: ...
    def setText(self, text: str) -> None: ...

class QRadioButton(QWidget):
    def __init__(self, text: str, parent: Any = None) -> None: ...
    def isChecked(self) -> bool: ...
    def setChecked(self, checked: bool) -> None: ...

class QCheckBox(QWidget):
    def __init__(self, text: str, parent: Any = None) -> None: ...
    def isChecked(self) -> bool: ...
    def setChecked(self, checked: bool) -> None: ...

class QPushButton(QWidget):
    clicked: Any
    def __init__(self, text: str, parent: Any = None) -> None: ...
    def setText(self, text: str) -> None: ...
    def text(self) -> str: ...

class QBoxLayout:
    def __init__(self, parent: Any = None) -> None: ...
    def addWidget(self, widget: Any) -> None: ...
    def addLayout(self, layout: Any) -> None: ...

class QVBoxLayout(QBoxLayout): ...
class QHBoxLayout(QBoxLayout): ...

class QFormLayout(QBoxLayout):
    def addRow(self, label: Any, field: Any) -> None: ...

class QComboBox(QWidget):
    def __init__(self, parent: Any = None) -> None: ...
    def addItem(self, text: str, data: Any = None) -> None: ...
    def insertItem(self, index: int, text: str, data: Any = None) -> None: ...
    def clear(self) -> None: ...
    def findData(self, data: Any) -> int: ...
    def currentData(self) -> Any: ...
    def setCurrentIndex(self, index: int) -> None: ...

class QListWidget(QWidget):
    def __init__(self, parent: Any = None) -> None: ...
    def addItems(self, items: list[str]) -> None: ...
    def clear(self) -> None: ...
    def selectedItems(self) -> list[Any]: ...
    def setSelectionMode(self, mode: Any) -> None: ...

class QAbstractItemView(QWidget):
    class SelectionBehavior:
        SelectRows: Any

    class SelectionMode:
        SingleSelection: Any
        ExtendedSelection: Any

class QTableWidgetItem:
    def __init__(self, text: str = '') -> None: ...
    def text(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def flags(self) -> Any: ...
    def setFlags(self, flags: Any) -> None: ...

class QTableWidget(QAbstractItemView):
    def __init__(self, rows: int, columns: int, parent: Any = None) -> None: ...
    def setHorizontalHeaderLabels(self, labels: list[str]) -> None: ...
    def verticalHeader(self) -> Any: ...
    def setRowCount(self, count: int) -> None: ...
    def rowCount(self) -> int: ...
    def insertRow(self, row: int) -> None: ...
    def removeRow(self, row: int) -> None: ...
    def item(self, row: int, column: int) -> QTableWidgetItem | None: ...
    def setItem(self, row: int, column: int, item: QTableWidgetItem) -> None: ...
    def cellWidget(self, row: int, column: int) -> Any: ...
    def setCellWidget(self, row: int, column: int, widget: Any) -> None: ...
    def selectRow(self, row: int) -> None: ...
    def currentRow(self) -> int: ...

class QMessageBox(QWidget):
    class StandardButton:
        Yes: Any
        No: Any

    @staticmethod
    def question(parent: Any, title: str, text: str, buttons: Any = ..., default: Any = ...) -> Any: ...

class QFileDialog(QWidget):
    @staticmethod
    def getOpenFileName(parent: Any, caption: str, directory: str, filter: str) -> tuple[str, str]: ...
    @staticmethod
    def getSaveFileName(parent: Any, caption: str, directory: str, filter: str) -> tuple[str, str]: ...

class QColorDialog(QWidget):
    @staticmethod
    def getColor(initial: Any, parent: Any = None, title: str = ...) -> QColor: ...

class QMenu(QWidget):
    aboutToShow: Any
    def addMenu(self, title: Any) -> QMenu: ...
    def addAction(self, text: Any, triggered: Any = None) -> Any: ...
    def addSeparator(self) -> Any: ...
    def clear(self) -> None: ...
    def removeAction(self, action: Any) -> None: ...

class QInputDialog(QWidget):
    @staticmethod
    def getItem(
        parent: Any,
        title: str,
        label: str,
        items: list[str],
        current: int = ...,
        editable: bool = ...,
        input_method_hints: Any = ...,
        flags: Any = ...,
    ) -> tuple[str, bool]: ...

class QByteArray:
    def __bytes__(self) -> bytes: ...

class QImage:
    class Format:
        Format_RGB32: Any

    def __init__(self, width: int, height: int, format: Any) -> None: ...
    def fill(self, colour: Any) -> None: ...
    def isNull(self) -> bool: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def scaled(self, width: int, height: int, aspect_ratio_mode: Any = ..., transform_mode: Any = ...) -> QImage: ...
    def scaledToWidth(self, width: int, transform_mode: Any = ...) -> QImage: ...
    def pixelColor(self, x: int, y: int) -> QColor: ...

class QColor:
    def __init__(self, colour: str) -> None: ...
    def name(self) -> str: ...
    def isValid(self) -> bool: ...
    def red(self) -> int: ...
    def green(self) -> int: ...
    def blue(self) -> int: ...

class QPixmap:
    def __init__(self, width: int, height: int) -> None: ...
    def fill(self, colour: Any) -> None: ...

class QIcon:
    def __init__(self, pixmap: Any = None) -> None: ...
    def isNull(self) -> bool: ...

class QPainter:
    def __init__(self, image: QImage) -> None: ...
    def fillRect(self, x: int, y: int, width: int, height: int, brush: Any) -> None: ...
    def end(self) -> None: ...

class QImageWriter:
    @staticmethod
    def supportedImageFormats() -> list[QByteArray]: ...

class Qt:
    class ItemFlag:
        ItemIsEditable: Any

    class AspectRatioMode:
        IgnoreAspectRatio: Any
        KeepAspectRatio: Any

    class TransformationMode:
        FastTransformation: Any
        SmoothTransformation: Any
