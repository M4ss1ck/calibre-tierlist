from typing import Any

class QObject:
    def __init__(self, parent: Any = None) -> None: ...

class QWidget(QObject):
    def __init__(self, parent: Any = None) -> None: ...
    def actions(self) -> list[Any]: ...
    def setEnabled(self, enabled: bool) -> None: ...
    def isEnabled(self) -> bool: ...
    def setVisible(self, visible: bool) -> None: ...
    def setStyleSheet(self, style: str) -> None: ...
    def setWindowTitle(self, title: str) -> None: ...
    def setToolTip(self, text: str) -> None: ...
    def setMinimumHeight(self, height: int) -> None: ...
    def setFixedHeight(self, height: int) -> None: ...
    def setFixedWidth(self, width: int) -> None: ...
    def setFixedSize(self, width: int, height: int) -> None: ...
    def setSizePolicy(self, horizontal: Any, vertical: Any) -> None: ...
    def setLayout(self, layout: Any) -> None: ...
    def update(self) -> None: ...
    def resizeEvent(self, event: Any) -> None: ...
    def showEvent(self, event: Any) -> None: ...
    def show(self) -> None: ...
    def resize(self, width_or_size: Any, height: int = ...) -> None: ...
    def size(self) -> QSize: ...
    def sizeHint(self) -> QSize: ...
    def screen(self) -> QScreen | None: ...
    # Added to QWidget by calibre.gui2.geometry at import time.
    def restore_geometry(self, prefs: Any, name: str) -> bool: ...
    def save_geometry(self, prefs: Any, name: str) -> None: ...

class QScreen:
    def availableGeometry(self) -> QRect: ...

class QRect:
    def size(self) -> QSize: ...

