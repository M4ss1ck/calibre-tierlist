from typing import Any

class QObject:
    def __init__(self, parent: Any = None) -> None: ...

class QWidget(QObject):
    def __init__(self, parent: Any = None) -> None: ...
    def actions(self) -> list[Any]: ...
    def setEnabled(self, enabled: bool) -> None: ...
    def isEnabled(self) -> bool: ...
    def setWindowTitle(self, title: str) -> None: ...

class QMainWindow(QWidget):
    def addAction(self, action: Any) -> None: ...

class QDialog(QWidget):
    DialogCode: Any
    def exec(self) -> int: ...
    def accept(self) -> None: ...
    def reject(self) -> None: ...
    def result(self) -> int: ...

class QLabel(QWidget):
    def __init__(self, text: str, parent: Any = None) -> None: ...

class QLineEdit(QWidget):
    def __init__(self, parent: Any = None) -> None: ...
    def text(self) -> str: ...
    def setText(self, text: str) -> None: ...

class QRadioButton(QWidget):
    def __init__(self, text: str, parent: Any = None) -> None: ...
    def isChecked(self) -> bool: ...
    def setChecked(self, checked: bool) -> None: ...

class QPushButton(QWidget):
    clicked: Any
    def __init__(self, text: str, parent: Any = None) -> None: ...

class QBoxLayout:
    def __init__(self, parent: Any = None) -> None: ...
    def addWidget(self, widget: Any) -> None: ...
    def addLayout(self, layout: Any) -> None: ...

class QVBoxLayout(QBoxLayout): ...
class QHBoxLayout(QBoxLayout): ...

class QMenu(QWidget):
    aboutToShow: Any
    def addMenu(self, title: Any) -> QMenu: ...
    def addAction(self, text: Any, triggered: Any = None) -> Any: ...
    def addSeparator(self) -> Any: ...
    def clear(self) -> None: ...
    def removeAction(self, action: Any) -> None: ...

class QInputDialog(QWidget):
    @staticmethod
    def getItem(
        parent: Any,
        title: str,
        label: str,
        items: list[str],
        current: int = ...,
        editable: bool = ...,
        input_method_hints: Any = ...,
        flags: Any = ...,
    ) -> tuple[str, bool]: ...

class QByteArray:
    def __bytes__(self) -> bytes: ...

class QImage:
    class Format:
        Format_RGB32: Any

    def __init__(self, width: int, height: int, format: Any) -> None: ...
    def fill(self, colour: Any) -> None: ...
    def isNull(self) -> bool: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def scaled(self, width: int, height: int, aspect_ratio_mode: Any = ..., transform_mode: Any = ...) -> QImage: ...
    def scaledToWidth(self, width: int, transform_mode: Any = ...) -> QImage: ...
    def pixelColor(self, x: int, y: int) -> QColor: ...

class QColor:
    def __init__(self, colour: str) -> None: ...
    def name(self) -> str: ...
    def red(self) -> int: ...
    def green(self) -> int: ...
    def blue(self) -> int: ...

class QImageWriter:
    @staticmethod
    def supportedImageFormats() -> list[QByteArray]: ...

class Qt:
    class AspectRatioMode:
        IgnoreAspectRatio: Any
        KeepAspectRatio: Any

    class TransformationMode:
        FastTransformation: Any
        SmoothTransformation: Any
