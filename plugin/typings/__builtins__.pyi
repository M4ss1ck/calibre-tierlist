"""Names calibre injects: `_` and `ngettext` into builtins, `load_translations`
and `get_icons` into every module it loads from a plugin zip. Declared here so strict type
checking sees them inside plugin code."""

from typing import Any

def _(s: str, /) -> str: ...
def ngettext(singular: str, plural: str, n: int, /) -> str: ...
def load_translations() -> None: ...
def get_icons(filename_or_names: str | list[str], plugin_name: str = ..., print_tracebacks: bool = ...) -> Any: ...
